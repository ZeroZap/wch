# .gitignore for WCH CH32 HAL project
# ZeroZap Organization

# ===========================================================================
# Build output directories
# ===========================================================================
build/
build-*/
obj/
obj-*/
out/
output/
cmake-build-*/
**/generated/
**/docs/generated/

# ===========================================================================
# Compiler / linker intermediates
# ===========================================================================
*.o
*.obj
*.d
*.su
*.i
*.ii
*.gcda
*.gcno
*.gcov

# ===========================================================================
# Libraries and firmware images
# NOTE: vendor prebuilt *.a / *.hex / *.bin (BLE / USB / ETH / motor libs and
# ROM images) are ignored on purpose too. Restore them locally if an example
# needs to link them.
# ===========================================================================
*.a
*.lib
*.so
*.dll
*.dylib
*.bin
*.hex
*.elf
*.axf
*.out
*.exe
*.map
*.lst

# ===========================================================================
# MounRiver Studio (MRS) / Eclipse generated project metadata
# NOTE: .cproject / .project / *.wvproj / *.wvsln are source files and stay tracked.
# ===========================================================================
.settings/
.metadata/
RemoteSystemsTempFiles/
*.launch
*.mrs
*.mrsproj
.rst*

# ===========================================================================
# Other IDE files
# ===========================================================================
.vscode/
.idea/
.history/
*.swp
*.swo
*.bak
*.uvproj*
*.uvopt*
*.Keil*
*.IAR*

# ===========================================================================
# CMake / ninja / clangd generated files
# ===========================================================================
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
.ninja_deps
.ninja_log
compile_commands.json
.cache/

# ===========================================================================
# Python generated files (example helper tools)
# ===========================================================================
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# ===========================================================================
# Logs and temp files
# ===========================================================================
*.log
logs/
*.tmp
*.orig
*.rej
*~
.dsh-tmp/
/core
core.[0-9]*
*.stackdump

# ===========================================================================
# OS-specific files
# ===========================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
